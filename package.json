{
  "name": "demosdk-docs-mcp",
  "version": "1.0.0",
  "description": "Efficient MCP server for Demos SDK API documentation",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node ./dist/index.js",
    "start:http": "node ./dist/index.js --http --port=3000",
    "dev": "tsx watch ./src/index.ts",
    "dev:http": "tsx watch ./src/index.ts --http --port=3000",
    "clone-docs": "tsx ./src/scripts/clone-docs.ts",
    "update-docs": "tsx ./src/scripts/update-docs.ts",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d --build",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.2",
    "cheerio": "^1.0.0",
    "tiktoken": "^1.0.17",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}