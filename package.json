{
  "name": "demosdk-api-ref-mcp",
  "version": "1.0.0",
  "description": "MCP server for TypeDoc documentation crawling and search",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && chmod +x dist/index.js && chmod +x dist/index-http.js",
    "start": "node dist/index.js",
    "start:http": "node dist/index-http.js",
    "dev": "tsx src/index.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "update-docs": "./scripts/update-docs.sh",
    "update-and-rebuild": "./scripts/update-docs.sh --rebuild",
    "inspect": "node scripts/inspect.js",
    "test-search": "node scripts/test-search.js",
    "test-sse": "node scripts/test-sse.js",
    "test-mcp-client": "node scripts/test-mcp-client.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "cheerio": "^1.0.0-rc.12",
    "sqlite3": "^5.1.6",
    "chokidar": "^3.5.3",
    "crypto": "^1.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/jest": "^29.0.0",
    "typescript": "^5.0.0",
    "tsx": "^4.0.0",
    "jest": "^29.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  },
  "keywords": ["mcp", "typedoc", "documentation", "crawler", "search"],
  "author": "",
  "license": "MIT"
}